# Copy to deploy.env (git-ignored) and edit. Used by ./deploy.sh

# user@host of the NAS
OPDS_HOST=user@192.168.1.50

# where the application lives on the NAS
OPDS_REMOTE=/volume1/Contents/OpdsServer

# python interpreter on the NAS: whatever `which python3` reported
OPDS_PYTHON=/usr/local/bin/python3.9
